            "size": 13808,
            "mimeType": "text/html",
            "text": "\r\n\t  \r\n<!DOCTYPE html PUBLIC \"-//W3C//DTD HTML 4.01 Transitional//EN\" \"http://www.w3.org/TR/html4/loose.dtd\">\r\n<html>\r\n<head>\r\n<meta http-equiv=\"Content-Type\" content=\"text/html; charset=ISO-8859-1\">\r\n<title>Welcome Student</title>\r\n<style>\r\ntable\r\n{\r\n\tfont-size:medium;\r\n\tfont-weight:bold;\r\n}\r\n.table_pa\r\n{\r\n\tborder:1px solid #9bf;\r\n\theight:300px;\r\n\t//width:150px;\r\n}\r\n.table_heading\r\n{\r\n\theight:40px;\r\n\tbackground-color:#007fbf;\r\n\tcolor:#fff;\r\n\tfont-weight:bold;\r\n}\r\n.link\r\n{\r\n\tcolor:#000;\r\n\ttext-decoration:underline;\r\n\tfont-size:14px;\r\n}\r\n.link:hover\r\n{\r\n\tfont-weight:bold;\r\n\ttext-decoration:underline;\r\n\tcolor:#008;\r\n}\r\n.staff_name\r\n{\r\n\tfont-weight:bold;\r\n\tfont-size:12px;\r\n\tcolor:#200;\r\n}\r\n.staff_desg\r\n{\r\n\tfont-weight:bold;\r\n\tfont-size:10px;\r\n\tcolor:#200;\r\n}\r\nul\r\n{\r\n\tlist-style:none;\r\n}\r\n.list_heading\r\n{\r\n\tfont-size:14px;\r\n}\r\n.list_heading:hover\r\n{\r\n\ttext-decoration:none;;\r\n}\r\n#msg\r\n{\r\n\tcolor:#362;\r\n\tfont-size:14px;\r\n}\r\n</style>\r\n<script src=\"ModalPopupWindow.js\" type=\"text/javascript\"></script>\r\n<script>\r\n var modalWin = new CreateModalPopUpObject();\r\n //Uncomment below line to make look buttons as link\r\n //modalWin.SetButtonStyle(\"background:none;border:none;textDecoration:underline;cursor:pointer\");\r\nfunction ShowNewPage1(){\r\n\t//alert(eid);\r\n\tvar w=460;//(screen.width-500);\r\n\t var h=330;//(screen.height-780);\r\n modalWin.ShowURL('profilepicupload.jsp',h,w,\"Upload Photo....\");\r\n }\r\nfunction HideModalWindow() {\r\n    modalWin.HideModalPopUp();\r\n}\r\n </script>\r\n</head>\r\n<body bgcolor=\"#808080\" onload=\"dBB();\">\r\n\r\n    <meta http-equiv=\"X-UA-Compatible\" content=\"IE=8,IE=7\" />\r\n    <link rel=\"stylesheet\" type=\"text/css\" media=\"all\" href=\"menu.css\" />\r\n    <link rel=\"stylesheet\" type=\"text/css\" media=\"all\" href=\"/ais/css/studentmenu.css\">\r\n    \r\n            <center>\r\n                <table style=\"BACKGROUND-COLOR: white\" border=\"0\" cellspacing=\"0\" cellpadding=\"0\" width=\"90%\">\r\n                    <tbody>\r\n                        <tr>\r\n                            <td valign=\"top\" align=\"left\">\r\n                                <table border=\"0\" cellspacing=\"0\" cellpadding=\"0\" width=\"100%\">\r\n                                    <tbody>\r\n                                        <tr>\r\n                                            <td style=\"WIDTH: 100px\" valign=\"top\" align=\"left\"><img style=\"BORDER-RIGHT-WIDTH: 0px; BORDER-TOP-WIDTH: 0px; BORDER-BOTTOM-WIDTH: 0px; BORDER-LEFT-WIDTH: 0px\" id=\"\" alt=\"topleft\" src=\"./sislogin.jsp_files/topleft.gif\"></td>\r\n                                            <td style=\"WIDTH: 5%\" valign=\"top\" align=\"right\"><img style=\"BORDER-RIGHT-WIDTH: 0px; BORDER-TOP-WIDTH: 0px; BORDER-BOTTOM-WIDTH: 0px; BORDER-LEFT-WIDTH: 0px\" id=\"\" alt=\"topright\" src=\"./sislogin.jsp_files/topright.gif\"></td>\r\n                                        </tr>\r\n                                    </tbody>\r\n                                </table>\r\n                            </td>\r\n                        </tr>\r\n                        <tr>\r\n                            <td valign=\"top\" width=\"160\" align=\"middle\"><img style=\"BORDER-RIGHT-WIDTH: 0px; WIDTH: 800px; BORDER-TOP-WIDTH: 0px; BORDER-BOTTOM-WIDTH: 0px; HEIGHT: 80px; BORDER-LEFT-WIDTH: 0px;border-radius:20px;\" id=\"ctl00_HeaderImage\" alt=\"sislogo\" src=\"./sislogin.jsp_files/sislogo.jpg\"></td>\r\n                        </tr>\r\n                    </tbody>\r\n                </table>\r\n                <table cellspacing=\"0\" cellpadding=\"0\" width=\"90%\" bgcolor=\"#a9a9a9\">\r\n                    <tbody>\r\n                        <tr>\r\n\r\n                            \r\n                                <td height=\"19\"